# =============================================================================
# PAYMENTS deploy -- environment REFERENCE (.env.example)
# =============================================================================
#
# The real ./.env is a symlink to /opt/payments/.env, GENERATED by
# `payments-deploy.sh install` and never committed. This file documents every
# variable: what it does, who writes it, and what a sane value looks like.
#
# THREE ORIGINS, and the difference decides what a re-install does to a value:
#
#   MINTED    -- generated by `install` with `openssl rand`, written ONCE.
#                Never re-minted while the file exists: re-minting the
#                database password beside a surviving data volume locks the
#                stack out of its own database.
#   ASKED     -- external facts no script can invent. `install` prompts for
#                them on a fresh file and never again. An empty answer is
#                re-asked rather than accepted: a placeholder in a wallet
#                address is an address a human sends money to.
#   DELIVERED -- written into this file by the PRODUCT's installer, the same
#                seam that carries PRODUCT_ENV_PATH. Empty on a fresh file.
#
# The two committed .env.example files are not duplicates: this one is the
# deploy environment of a running instance, and the one in the repository root
# is the reference for a developer's own machine.
# =============================================================================

# -- Application ------------------------------------------------------------
# Operator-owned.
APP_ENV=production
LOG_LEVEL=INFO

# -- Postgres (dedicated payments database) ---------------------------------
# POSTGRES_* feed the payments-postgres container itself; DATABASE_URL is what
# the payments processes dial. MINTED.
POSTGRES_USER=payments
POSTGRES_DB=payments
POSTGRES_PASSWORD=<minted-by-install>
DATABASE_URL=postgresql+asyncpg://payments:<minted-by-install>@payments-postgres:5432/payments

# -- The trust seam (TOR sections 8 and 9) ----------------------------------
# MINTED here, handed to the product as PAYMENTS_SERVICE_TOKEN. The product
# presents it as `Authorization: Bearer <token>` on every inbound call. The
# service refuses to start on a blank one: a blank token compared against a
# blank header authenticates everybody.
SERVICE_TOKEN=<minted-by-install>

# MINTED here, handed to the product as PAYMENTS_WEBHOOK_SECRET. Travels in
# the `X-Payments-Secret` header of every outgoing event. Blank refuses to
# start, for the mirror-image reason: `compare_digest("", "")` is true.
PAYMENTS_WEBHOOK_SECRET=<minted-by-install>

# DELIVERED by the product's installer: the address of its webhook receiver on
# aivis-shared. No product path is written anywhere in this repository -- the
# value belongs to whoever runs the product.
#
# The service does not start with this empty, so `install` brings the stack up
# only once it has been delivered. That is the whole reason install runs twice.
PRODUCT_WEBHOOK_URL=

# -- Wallet addresses -- ASKED ----------------------------------------------
# Where users send USDT. Snapshotted onto every invoice at creation, so a wrong
# value here is not a broken next payment: it is copied into the database and
# survives every later correction of this file.
#
# TRC20 is verified by its base58check checksum, so a mistyped character is
# refused. ERC20 and BSC20 are checked for length and alphabet only -- see
# app/domain/addresses.py for why, and for what that does not catch.
WALLET_ADDRESS_USDT_TRC20=
WALLET_ADDRESS_USDT_ERC20=
WALLET_ADDRESS_USDT_BSC20=

# -- Explorer credentials -- ASKED ------------------------------------------
# One Etherscan V2 key covers ERC20 and BSC20 through `chainid`. A blank key is
# not refused by Etherscan, it is silently rate-limited, so the service refuses
# it instead.
ETHERSCAN_API_KEY=
# TronScan throttles unkeyed callers rather than refusing them, so a blank key
# fails intermittently under load instead of at startup.
TRONSCAN_API_KEY=

# -- Explorer endpoints -----------------------------------------------------
# Defaults are correct for mainnet; override to point at a mirror.
ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
TRONSCAN_API_URL=https://apilist.tronscanapi.com/api

# -- Everything below has a working default -------------------------------
# Present here as documentation, not as something install writes. A field with
# a default does not stop the service from booting, so `install` leaves them
# out of the generated file entirely and the code's own defaults apply.
#
# CONFIRMATIONS_REQUIRED_TRC20=20
# CONFIRMATIONS_REQUIRED_ERC20=12
# CONFIRMATIONS_REQUIRED_BSC20=15
# INVOICE_TTL_MINUTES=60
# MAX_TXID_ATTEMPTS=3
# MAX_OBSERVATION_WINDOW_DAYS=7
# WEBHOOK_MAX_ATTEMPTS=12
# WEBHOOK_BACKOFF_MIN_SECONDS=5.0
# WEBHOOK_BACKOFF_MAX_SECONDS=3600.0
# WEBHOOK_TIMEOUT_SECONDS=10.0
# WEBHOOK_LEASE_SECONDS=60.0
# WORKER_TICK_SECONDS=5.0
# WORKER_POLL_MIN_SECONDS=30.0
# WORKER_POLL_MAX_SECONDS=3600.0
# WORKER_LEASE_SECONDS=300.0
# WORKER_BATCH_SIZE=50

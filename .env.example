# Infrastructure
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments

# Wallet addresses -- mandatory, no defaults
WALLET_ADDRESS_USDT_TRC20=
WALLET_ADDRESS_USDT_ERC20=
WALLET_ADDRESS_USDT_BSC20=

# Confirmation thresholds per network
CONFIRMATIONS_REQUIRED_TRC20=20
CONFIRMATIONS_REQUIRED_ERC20=12
CONFIRMATIONS_REQUIRED_BSC20=15

# Invoice lifecycle
INVOICE_TTL_MINUTES=60
MAX_TXID_ATTEMPTS=3
MAX_OBSERVATION_WINDOW_DAYS=7

# Bearer credential the product sends on every inbound call (TOR section 8;
# the product calls it PAYMENTS_SERVICE_TOKEN on its side). Mandatory: the
# service refuses to start on a blank one, because a blank token matches a
# blank header and would authenticate everybody.
SERVICE_TOKEN=

# Explorers. Both base URLs have defaults; override to point at a mirror or
# a testnet gateway. The API key has none -- a blank one is not refused by
# Etherscan, it is silently rate-limited, so the service refuses it instead.
ETHERSCAN_API_KEY=
ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
TRONSCAN_API_URL=https://apilist.tronscan.org/api

# USDT contracts and decimals.
# BSC is Binance-Peg BSC-USD with 18 decimals, not 6 -- there is no single
# formula across networks.
USDT_CONTRACT_ERC20=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDT_CONTRACT_BSC20=0x55d398326f99059fF775485246999027B3197955
USDT_CONTRACT_TRC20=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_DECIMALS_TRC20=6
USDT_DECIMALS_ERC20=6
USDT_DECIMALS_BSC20=18
